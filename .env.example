# HTTP binding. Change KOSHA_PORT to any free port, then restart Kosha.
# Keep loopback behind an HTTPS proxy; 0.0.0.0 exposes all IPv4 interfaces.
KOSHA_HOST=127.0.0.1
KOSHA_PORT=8080

# Relative paths are resolved from the process working directory.
# For the systemd example, use /var/lib/kosha/kosha.db here.
KOSHA_DATABASE=data/kosha.db

# Inactive room retention: 336 hours = 14 days. Active rooms are protected;
# the full period starts again after the last participant leaves.
# Use Go duration units (h/m/s); "14d" is not supported. Restart to apply.
KOSHA_ROOM_TTL=336h

# Concurrent loaded rooms and participants per room (each: 1..100).
KOSHA_MAX_ROOMS=5
KOSHA_MAX_PEERS=5

# Incoming WebSocket message size in bytes; this is not a document size limit.
KOSHA_MAX_MESSAGE_BYTES=1048576

# Private diagnostics at /debug/metrics; keep false for normal use.
KOSHA_METRICS=false
